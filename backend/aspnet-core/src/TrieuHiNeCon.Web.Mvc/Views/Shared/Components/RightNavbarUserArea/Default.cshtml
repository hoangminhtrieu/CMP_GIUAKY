@model TrieuHiNeCon.Web.Views.Shared.Components.RightNavbarUserArea.RightNavbarUserAreaViewModel
@if (Model?.LoginInformations?.User != null)
{
    <li class="nav-item dropdown nav-user-menu">
        <a href="javascript:void(0);" class="nav-link d-flex align-items-center" data-toggle="dropdown" role="button">
            <i class="fas fa-user-circle fa-2x text-primary mr-1"></i>
            <span class="d-none d-md-inline font-weight-bold text-dark ml-1">@Model.GetShownLoginName()</span>
        </a>
        <div class="dropdown-menu dropdown-menu-right">
            <a class="dropdown-item" asp-controller="Users" asp-action="ChangePassword">
                <i class="fas fa-user-edit"></i> @L("UpdatePassword")
            </a>
            <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                <i class="fas fa-sign-out-alt"></i> @L("Logout")
            </a>
        </div>
    </li>
}
else
{
    <li class="nav-item d-flex align-items-center">
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm my-1 mr-2 font-weight-bold">
            <i class="fas fa-sign-in-alt mr-1"></i> Đăng nhập
        </a>
    </li>
}
