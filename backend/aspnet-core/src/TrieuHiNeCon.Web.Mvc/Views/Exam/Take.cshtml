@using TrieuHiNeCon.Toeic.Dtos
@model AdminExamPreviewDto

@{
    ViewBag.Title = "Thi TOEIC - " + (Model?.Title ?? "Làm bài thi");
    Layout = null; // Giao diện thi toàn màn hình theo chuẩn Figma
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ứng dụng thi TOEIC - @Model.Title</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #3730a3;
            --primary-light: #e0e7ff;
            --accent: #0ea5e9;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --dark: #0f172a;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --bg-page: #f8fafc;
            --bg-card: #ffffff;
            --border: #e2e8f0;
            --radius-lg: 16px;
            --radius-md: 10px;
            --shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.04);
            --shadow-md: 0 8px 24px rgba(15, 23, 42, 0.08);
            --shadow-lg: 0 16px 36px rgba(15, 23, 42, 0.12);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-page);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* HEADER FIGMA */
        header {
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);
            color: #ffffff;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-brand {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .brand-icon {
            width: 42px;
            height: 42px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(8px);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            color: #a5b4fc;
        }

        header h1 {
            font-size: 1.35rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 0.15rem;
        }

        .header-sub {
            font-size: 0.8rem;
            color: #cbd5e1;
            font-weight: 400;
        }

        /* TIMER THEO FIGMA */
        .timer-badge {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 0.55rem 1.15rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.95rem;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
        }

        .timer-badge i {
            color: #facc15;
            font-size: 1.1rem;
        }

        .timer-badge.warning {
            background: rgba(239, 68, 68, 0.25);
            border-color: #ef4444;
            color: #fecaca;
            animation: pulse 1s infinite alternate;
        }

        @@keyframes pulse {
            0% { transform: scale(1); }
            100% { transform: scale(1.04); }
        }

        /* MAIN LAYOUT */
        main {
            flex: 1;
            max-width: 1300px;
            width: 100%;
            margin: 1.5rem auto;
            padding: 0 1.5rem;
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 1.75rem;
            align-items: start;
        }

        /* QUESTION CONTAINER */
        .question-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            padding: 2rem;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-md);
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .part-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--primary-light);
            color: var(--primary-dark);
            font-size: 0.8rem;
            font-weight: 700;
            padding: 0.35rem 0.85rem;
            border-radius: 50px;
            align-self: flex-start;
        }

        /* PASSAGE AREA (Part 6 & Part 7) */
        .passage-box {
            background: #f1f5f9;
            border-left: 4px solid var(--primary);
            padding: 1.25rem 1.5rem;
            border-radius: var(--radius-md);
            font-size: 0.95rem;
            line-height: 1.65;
            color: #334155;
            white-space: pre-line;
            max-height: 340px;
            overflow-y: auto;
        }

        .passage-title {
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--primary);
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .question-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text-main);
            line-height: 1.5;
        }

        /* OPTIONS LIST */
        .options-list {
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
        }

        .option-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.25rem;
            border-radius: var(--radius-md);
            border: 2px solid var(--border);
            background: #ffffff;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            user-select: none;
        }

        .option-item:hover {
            border-color: #a5b4fc;
            background: #f8fafc;
            transform: translateX(4px);
        }

        .option-item.selected {
            border-color: var(--primary);
            background: #eef2ff;
            box-shadow: 0 2px 10px rgba(79, 70, 229, 0.12);
        }

        .option-item input[type="radio"] {
            appearance: none;
            width: 22px;
            height: 22px;
            border: 2px solid #cbd5e1;
            border-radius: 50%;
            display: grid;
            place-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .option-item input[type="radio"]::before {
            content: "";
            width: 10px;
            height: 10px;
            border-radius: 50%;
            transform: scale(0);
            transition: 120ms transform ease-in-out;
            background-color: var(--primary);
        }

        .option-item.selected input[type="radio"] {
            border-color: var(--primary);
        }

        .option-item.selected input[type="radio"]::before {
            transform: scale(1);
        }

        .option-key {
            font-weight: 800;
            color: var(--primary);
            min-width: 24px;
        }

        .option-text {
            font-size: 1rem;
            font-weight: 500;
            color: var(--text-main);
            flex: 1;
        }

        /* BUTTONS ACTIONS */
        .action-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 1rem;
            border-top: 1px solid var(--border);
            margin-top: 0.5rem;
        }

        .btn {
            padding: 0.75rem 1.4rem;
            font-size: 0.95rem;
            font-weight: 700;
            border-radius: var(--radius-md);
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.2s ease;
            font-family: inherit;
        }

        .btn-prev {
            background: #e2e8f0;
            color: #475569;
        }

        .btn-prev:hover:not(:disabled) {
            background: #cbd5e1;
            color: #1e293b;
        }

        .btn-next {
            background: var(--primary);
            color: #ffffff;
        }

        .btn-next:hover:not(:disabled) {
            background: var(--primary-dark);
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
            transform: translateY(-1px);
        }

        .btn-submit {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
        }

        .btn-submit:hover {
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
            transform: translateY(-1px);
        }

        .btn:disabled {
            opacity: 0.45;
            cursor: not-allowed;
            transform: none !important;
        }

        /* SIDEBAR NAVIGATOR */
        .sidebar-navigator {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            padding: 1.5rem;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-md);
            position: sticky;
            top: 5.5rem;
        }

        .navigator-header {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .stat-badge {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--primary);
            background: var(--primary-light);
            padding: 0.25rem 0.65rem;
            border-radius: 50px;
        }

        .progress-track {
            height: 6px;
            background: #e2e8f0;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 1.25rem;
        }

        .progress-bar-fill {
            height: 100%;
            background: var(--primary);
            width: 0%;
            transition: width 0.3s ease;
        }

        .questions-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 0.5rem;
            max-height: 400px;
            overflow-y: auto;
            padding-right: 0.25rem;
        }

        .grid-num-btn {
            height: 38px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: #ffffff;
            color: var(--text-muted);
            font-size: 0.85rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .grid-num-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        .grid-num-btn.answered {
            background: #10b981;
            border-color: #10b981;
            color: #ffffff;
        }

        .grid-num-btn.active {
            border: 2px solid var(--primary);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.25);
            color: var(--primary);
            font-weight: 800;
        }

        .grid-num-btn.answered.active {
            background: #059669;
            color: #ffffff;
        }

        /* MODAL SUBMIT THEO FIGMA */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(4px);
            z-index: 999;
            place-content: center;
        }

        .submit-confirmation-modal {
            background: #ffffff;
            border-radius: var(--radius-lg);
            width: 90%;
            max-width: 460px;
            padding: 2.25rem;
            box-shadow: var(--shadow-lg);
            text-align: center;
            animation: modalPop 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        @@keyframes modalPop {
            0% { transform: scale(0.9); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .modal-icon {
            width: 64px;
            height: 64px;
            background: #fef3c7;
            color: #d97706;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.85rem;
            margin-bottom: 1rem;
        }

        .submit-confirmation-modal h2 {
            font-size: 1.35rem;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 0.65rem;
        }

        .submit-confirmation-modal p {
            color: var(--text-muted);
            font-size: 1rem;
            line-height: 1.5;
            margin-bottom: 1.75rem;
        }

        .submit-confirmation-modal .unanswered-count {
            font-weight: 800;
            color: var(--danger);
        }

        .modal-actions {
            display: flex;
            gap: 1rem;
            justify-content: center;
        }

        .modal-actions button {
            flex: 1;
            padding: 0.85rem;
            border-radius: var(--radius-md);
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            border: none;
            transition: all 0.2s ease;
        }

        .btn-cancel {
            background: #f1f5f9;
            color: #475569;
        }

        .btn-cancel:hover {
            background: #e2e8f0;
        }

        .btn-confirm-submit {
            background: var(--primary);
            color: #ffffff;
        }

        .btn-confirm-submit:hover {
            background: var(--primary-dark);
            box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35);
        }

        /* RESULT VIEW */
        .result-view {
            display: none;
            background: #ffffff;
            border-radius: var(--radius-lg);
            padding: 3rem 2rem;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-lg);
            max-width: 720px;
            margin: 2rem auto;
            text-align: center;
        }

        .score-circle {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%);
            color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin: 1.5rem auto;
            box-shadow: 0 8px 24px rgba(79, 70, 229, 0.3);
        }

        .score-num {
            font-size: 2.5rem;
            font-weight: 800;
            line-height: 1;
        }

        .score-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: 0.9;
        }

        .result-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.25rem;
            margin: 2rem 0;
        }

        .stat-card {
            padding: 1.25rem;
            border-radius: var(--radius-md);
            background: #f8fafc;
            border: 1px solid var(--border);
        }

        .stat-val {
            font-size: 1.75rem;
            font-weight: 800;
        }

        .stat-desc {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 0.25rem;
        }

        @@media (max-width: 992px) {
            main {
                grid-template-columns: 1fr;
            }
            .sidebar-navigator {
                order: 2;
                position: static;
            }
        }
    </style>
</head>
<body>
    <header>
        <div class="header-brand">
            <div class="brand-icon">
                <i class="fas fa-graduation-cap"></i>
            </div>
            <div>
                <h1>Ứng dụng thi TOEIC</h1>
                <div class="header-sub">@Model.Title · 100 câu hỏi (Part 5, 6, 7)</div>
            </div>
        </div>
        <div class="timer-badge" id="timerBadge">
            <i class="far fa-clock"></i>
            <span id="timerText">Thời gian còn lại: 75:00</span>
        </div>
    </header>

    <!-- MAIN EXAM CONTAINER -->
    <main id="examMain">
        <!-- QUESTION AREA -->
        <div class="question-card" id="questionCard">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span class="part-badge" id="partBadge">Part 5: Incomplete Sentences</span>
                <span style="font-weight: 700; color: var(--text-muted); font-size: 0.9rem;" id="progressLabel">Câu 1/100</span>
            </div>

            <!-- PASSAGE (HIỂN THỊ KHI Ở PART 6 / 7) -->
            <div class="passage-box" id="passageBox" style="display: none;">
                <div class="passage-title">
                    <i class="fas fa-file-alt"></i> Đoạn văn đọc hiểu
                </div>
                <div id="passageContent"></div>
            </div>

            <!-- QUESTION TEXT -->
            <div class="question-title" id="questionTitle">
                Đang tải dữ liệu câu hỏi...
            </div>

            <!-- 4 OPTIONS (A, B, C, D) -->
            <div class="options-list" id="optionsContainer">
                <!-- Javascript render options -->
            </div>

            <!-- NAVIGATION ACTIONS -->
            <div class="action-bar">
                <button class="btn btn-prev" id="btnPrev" onclick="handlePrevQuestion()">
                    <i class="fas fa-arrow-left"></i> Câu trước
                </button>
                <div style="display: flex; gap: 0.75rem;">
                    <button class="btn btn-next" id="btnNext" onclick="handleNextQuestion()">
                        Câu tiếp theo <i class="fas fa-arrow-right"></i>
                    </button>
                    <button class="btn btn-submit" id="btnSubmitTop" onclick="handleOpenSubmitModal()">
                        <i class="fas fa-paper-plane"></i> Nộp bài
                    </button>
                </div>
            </div>
        </div>

        <!-- SIDEBAR NAVIGATOR -->
        <div class="sidebar-navigator">
            <div class="navigator-header">
                <span>Bảng câu hỏi</span>
                <span class="stat-badge" id="answeredCountBadge">0/100 đã làm</span>
            </div>
            <div class="progress-track">
                <div class="progress-bar-fill" id="progressBarFill"></div>
            </div>
            <div class="questions-grid" id="questionsGrid">
                <!-- Grid 1 - 100 -->
            </div>
            <div style="margin-top: 1.5rem;">
                <button class="btn btn-submit" style="width: 100%; justify-content: center;" onclick="handleOpenSubmitModal()">
                    <i class="fas fa-check-circle"></i> Nộp bài ngay
                </button>
            </div>
        </div>
    </main>

    <!-- SUBMIT CONFIRMATION MODAL THEO FIGMA -->
    <div class="modal-overlay" id="submitModal">
        <div class="submit-confirmation-modal">
            <div class="modal-icon">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <h2>Xác nhận nộp bài</h2>
            <p id="submitModalText">
                Bạn còn <span class="unanswered-count" id="unansweredCount">100</span> câu chưa làm.
            </p>
            <div class="modal-actions">
                <button class="btn-cancel" onclick="handleCloseSubmitModal()">Quay lại làm tiếp</button>
                <button class="btn-confirm-submit" onclick="handleSubmitExam()">Nộp bài ngay</button>
            </div>
        </div>
    </div>

    <!-- RESULT VIEW -->
    <div class="result-view" id="resultView">
        <h2 style="font-size: 1.85rem; font-weight: 800; margin-bottom: 0.5rem;">Kết quả Bài thi TOEIC</h2>
        <p style="color: var(--text-muted); font-size: 1rem;">@Model.Title</p>

        <div class="score-circle">
            <span class="score-num" id="resultScore">0</span>
            <span class="score-label">Điểm số</span>
        </div>

        <div class="result-stats">
            <div class="stat-card">
                <div class="stat-val" style="color: var(--success);" id="statCorrect">0</div>
                <div class="stat-desc">Số câu Đúng</div>
            </div>
            <div class="stat-card">
                <div class="stat-val" style="color: var(--danger);" id="statWrong">0</div>
                <div class="stat-desc">Số câu Sai</div>
            </div>
            <div class="stat-card">
                <div class="stat-val" style="color: var(--warning);" id="statSkipped">0</div>
                <div class="stat-desc">Bỏ qua / Chưa làm</div>
            </div>
        </div>

        <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 2rem;">
            <a href="/Exam" class="btn btn-prev">
                <i class="fas fa-arrow-left"></i> Về danh sách đề thi
            </a>
            <button class="btn btn-next" onclick="location.reload()">
                <i class="fas fa-redo"></i> Thi lại đề này
            </button>
        </div>
    </div>

    <script>
        // DỮ LIỆU ĐỀ THI TỪ ASP.NET CORE BACKEND
        const rawModel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
        
        // Chuẩn hóa toàn bộ câu hỏi (Level 1 + Level 2) thành danh sách phẳng 100 câu
        let questions = [];
        
        // 1. Thêm Level 1 (Part 5: 101 - 130)
        if (rawModel.Level1Questions && rawModel.Level1Questions.length > 0) {
            rawModel.Level1Questions.forEach(q => {
                questions.push({
                    id: q.Id,
                    number: q.QuestionNumber,
                    part: "Part 5",
                    passage: null,
                    question: `Câu ${q.QuestionNumber}: ${q.QuestionText}`,
                    options: q.Options.map(o => ({ key: o.OptionKey, text: o.OptionText })),
                    correctAnswer: q.CorrectAnswer,
                    answer: null
                });
            });
        }

        // 2. Thêm Level 2 (Part 6 & Part 7: 131 - 200)
        if (rawModel.Level2Groups && rawModel.Level2Groups.length > 0) {
            rawModel.Level2Groups.forEach(g => {
                const partLabel = g.PartNumber ? `Part ${g.PartNumber}` : "Part 7";
                if (g.Questions && g.Questions.length > 0) {
                    g.Questions.forEach(q => {
                        questions.push({
                            id: q.Id,
                            number: q.QuestionNumber,
                            part: partLabel,
                            passage: g.PassageText,
                            question: `Câu ${q.QuestionNumber}: ${q.QuestionText}`,
                            options: q.Options.map(o => ({ key: o.OptionKey, text: o.OptionText })),
                            correctAnswer: q.CorrectAnswer,
                            answer: null
                        });
                    });
                }
            });
        }

        // Sắp xếp câu hỏi theo thứ tự QuestionNumber
        questions.sort((a, b) => a.number - b.number);

        let currentIndex = 0;
        let timeLeft = 75 * 60; // 75 phút (theo chuẩn Figma & TOEIC)
        let timerInterval = null;

        // KHỞI TẠO APP
        window.addEventListener('DOMContentLoaded', () => {
            renderGrid();
            renderQuestion();
            startTimer();
        });

        // ĐỒNG HỒ ĐẾM NGƯỢC
        function startTimer() {
            const timerText = document.getElementById('timerText');
            const timerBadge = document.getElementById('timerBadge');

            timerInterval = setInterval(() => {
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    timerText.innerText = "Thời gian còn lại: 00:00";
                    alert("Đã hết thời gian 75 phút! Hệ thống sẽ tự động nộp bài.");
                    handleSubmitExam();
                    return;
                }

                timeLeft--;
                const minutes = Math.floor(timeLeft / 60);
                const seconds = ('0' + (timeLeft % 60)).slice(-2);
                timerText.innerText = `Thời gian còn lại: ${minutes}:${seconds}`;

                if (timeLeft < 300) { // Dưới 5 phút cảnh báo đỏ
                    timerBadge.classList.add('warning');
                }
            }, 1000);
        }

        // RENDER CÂU HỎI HIỆN TẠI
        function renderQuestion() {
            if (!questions || questions.length === 0) return;

            const q = questions[currentIndex];
            document.getElementById('partBadge').innerText = q.part;
            document.getElementById('progressLabel').innerText = `Câu ${currentIndex + 1}/${questions.length}`;
            document.getElementById('questionTitle').innerText = q.question;

            // Xử lý Passage nếu có
            const passageBox = document.getElementById('passageBox');
            const passageContent = document.getElementById('passageContent');
            if (q.passage && q.passage.trim().length > 0) {
                passageBox.style.display = 'block';
                passageContent.innerText = q.passage;
            } else {
                passageBox.style.display = 'none';
            }

            // Render 4 options A, B, C, D
            const optionsContainer = document.getElementById('optionsContainer');
            optionsContainer.innerHTML = '';

            q.options.forEach((opt, idx) => {
                const isChecked = q.answer === opt.key;
                const optionDiv = document.createElement('div');
                optionDiv.className = `option-item ${isChecked ? 'selected' : ''}`;
                optionDiv.onclick = () => handleSelectOption(opt.key);

                optionDiv.innerHTML = `
                    <input type="radio" name="optRadio" value="${opt.key}" ${isChecked ? 'checked' : ''} />
                    <span class="option-key">(${opt.key})</span>
                    <span class="option-text">${opt.text}</span>
                `;
                optionsContainer.appendChild(optionDiv);
            });

            // Nút Prev / Next
            document.getElementById('btnPrev').disabled = (currentIndex === 0);
            document.getElementById('btnNext').disabled = (currentIndex === questions.length - 1);

            updateGridHighlight();
            updateProgress();
        }

        // CHỌN ĐÁP ÁN
        function handleSelectOption(key) {
            questions[currentIndex].answer = key;
            renderQuestion();
            updateGridHighlight();
            updateProgress();
        }

        // ĐIỀU HƯỚNG
        function handleNextQuestion() {
            if (currentIndex < questions.length - 1) {
                currentIndex++;
                renderQuestion();
            }
        }

        function handlePrevQuestion() {
            if (currentIndex > 0) {
                currentIndex--;
                renderQuestion();
            }
        }

        function jumpToQuestion(idx) {
            currentIndex = idx;
            renderQuestion();
        }

        // RENDER GRID BẢNG CÂU HỎI
        function renderGrid() {
            const grid = document.getElementById('questionsGrid');
            grid.innerHTML = '';
            questions.forEach((q, idx) => {
                const btn = document.createElement('button');
                btn.id = `grid-btn-${idx}`;
                btn.className = 'grid-num-btn';
                btn.innerText = q.number;
                btn.onclick = () => jumpToQuestion(idx);
                grid.appendChild(btn);
            });
            updateGridHighlight();
        }

        function updateGridHighlight() {
            questions.forEach((q, idx) => {
                const btn = document.getElementById(`grid-btn-${idx}`);
                if (!btn) return;
                btn.className = 'grid-num-btn';
                if (q.answer !== null) {
                    btn.classList.add('answered');
                }
                if (idx === currentIndex) {
                    btn.classList.add('active');
                }
            });
        }

        function updateProgress() {
            const answeredCount = questions.filter(q => q.answer !== null).length;
            const percent = Math.round((answeredCount / questions.length) * 100);
            document.getElementById('answeredCountBadge').innerText = `${answeredCount}/${questions.length} đã làm`;
            document.getElementById('progressBarFill').style.width = `${percent}%`;
        }

        // MODAL XÁC NHẬN NỘP BÀI (THEO CODE FIGMA)
        function handleOpenSubmitModal() {
            const unanswered = questions.filter(q => q.answer === null).length;
            document.getElementById('unansweredCount').innerText = unanswered;
            document.getElementById('submitModal').style.display = 'grid';
        }

        function handleCloseSubmitModal() {
            document.getElementById('submitModal').style.display = 'none';
        }

        // NỘP BÀI & TÍNH ĐIỂM
        function handleSubmitExam() {
            clearInterval(timerInterval);
            handleCloseSubmitModal();

            // Tính điểm
            let correct = 0;
            let wrong = 0;
            let skipped = 0;

            questions.forEach(q => {
                if (q.answer === null) {
                    skipped++;
                } else if (q.answer.trim().toUpperCase() === (q.correctAnswer || '').trim().toUpperCase()) {
                    correct++;
                } else {
                    wrong++;
                }
            });

            // Gửi kết quả lên server nếu có endpoint
            fetch('/api/exam/submit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    attemptId: 0,
                    isTimedOut: timeLeft <= 0,
                    answers: questions.map(q => ({ questionId: q.id, selectedAnswer: q.answer }))
                })
            }).catch(e => console.log('Submit background logged.'));

            // Hiển thị màn hình kết quả
            document.getElementById('examMain').style.display = 'none';
            const resultView = document.getElementById('resultView');
            resultView.style.display = 'block';

            document.getElementById('resultScore').innerText = `${correct}/${questions.length}`;
            document.getElementById('statCorrect').innerText = correct;
            document.getElementById('statWrong').innerText = wrong;
            document.getElementById('statSkipped').innerText = skipped;
        }
    </script>
</body>
</html>
