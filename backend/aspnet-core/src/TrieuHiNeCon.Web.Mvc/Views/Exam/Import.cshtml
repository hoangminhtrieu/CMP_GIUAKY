@{
    ViewBag.Title = "Import Đề Thi TOEIC từ File Word";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <a href="/Exam" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách
                </a>
                <span class="badge badge-info px-3 py-2"><i class="fas fa-info-circle mr-1"></i>Định dạng chuẩn TOEIC Reading 100 câu</span>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 font-weight-bold"><i class="fas fa-file-word mr-2"></i>Upload Đề Thi TOEIC từ File Word (.docx)</h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-light border mb-4">
                        <h6 class="font-weight-bold text-dark mb-2"><i class="fas fa-shield-alt text-warning mr-1"></i>Cơ chế kiểm duyệt nghiêm ngặt:</h6>
                        <p class="mb-1 text-muted small">• Hệ thống chỉ lưu đề thi khi file đạt chuẩn <strong>100% cú pháp thẻ (Tags)</strong>.</p>
                        <p class="mb-1 text-muted small">• Nếu phát hiện thiếu tag, thiếu đáp án (phải đủ 4 đáp án A-D), hoặc sai thứ tự câu (101-200), toàn bộ quá trình sẽ <strong>hủy bỏ và không lưu vào CSDL</strong>.</p>
                        <p class="mb-0 text-muted small">• Level 1: Part 5 (Câu 101–130) | Level 2: Part 6 & 7 (Câu 131–200 có kèm đoạn văn hoặc hình ảnh).</p>
                    </div>

                    <form id="importForm" enctype="multipart/form-data">
                        <div class="form-group mb-3">
                            <label class="form-label font-weight-bold">Tên đề thi <span class="text-danger">*</span></label>
                            <input type="text" id="title" name="title" class="form-control"
                                   placeholder="VD: TOEIC Reading Actual Test 06" required />
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label font-weight-bold">Mô tả đề thi</label>
                            <textarea id="description" name="description" class="form-control" rows="2"
                                      placeholder="VD: Đề thi thử ETS TOEIC RC Test 06 (100 câu hỏi - 75 phút)"></textarea>
                        </div>
                        <div class="form-group mb-4">
                            <label class="form-label font-weight-bold">File Word (.docx) <span class="text-danger">*</span></label>
                            <input type="file" id="file" name="file" class="form-control" accept=".docx" required />
                            <small class="form-text text-muted mt-1">
                                Dung lượng tối đa: 20MB. Đảm bảo các thẻ <code>[L1]</code>, <code>[L2]</code>, <code>[PASSAGE]</code>, <code>[Q:xxx]</code>, <code>[ANS:x]</code>, <code>[END]</code> được định dạng chuẩn.
                            </small>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary px-4 py-2" id="btnImport">
                                <i class="fas fa-cloud-upload-alt mr-1"></i> Bắt đầu Kiểm tra & Import
                            </button>
                        </div>
                    </form>

                    <!-- Kết quả -->
                    <div id="resultArea" class="mt-4" style="display:none;">
                        <div id="successAlert" class="alert alert-success border-0 shadow-sm" style="display:none;">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-check-circle fa-2x mr-3 text-success"></i>
                                <div>
                                    <h6 class="font-weight-bold mb-1">Import thành công 100%!</h6>
                                    <span id="successMsg"></span>
                                </div>
                            </div>
                            <div class="mt-3">
                                <a id="previewLink" href="#" class="btn btn-sm btn-success mr-2">
                                    <i class="fas fa-eye mr-1"></i> Xem trước đề thi ngay
                                </a>
                                <a href="/Exam" class="btn btn-sm btn-outline-success">
                                    Quay lại danh sách
                                </a>
                            </div>
                        </div>

                        <div id="errorAlert" class="alert alert-danger border-0 shadow-sm" style="display:none;">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fas fa-exclamation-triangle fa-2x mr-3 text-danger"></i>
                                <div>
                                    <h6 class="font-weight-bold mb-0">Import thất bại! Đã hủy bỏ lưu vào CSDL.</h6>
                                    <small class="text-muted">Hệ thống phát hiện các lỗi định dạng sau trong file Word của bạn:</small>
                                </div>
                            </div>
                            <hr />
                            <ul id="errorList" class="mb-0 text-danger font-weight-bold" style="max-height: 250px; overflow-y: auto;"></ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    document.getElementById('importForm').addEventListener('submit', async function (e) {
        e.preventDefault();

        const btn = document.getElementById('btnImport');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm mr-1"></span> Đang phân tích file...';

        const formData = new FormData(this);

        try {
            const resp = await fetch('/api/exam/import', {
                method: 'POST',
                body: formData
            });

            const data = await resp.json();
            document.getElementById('resultArea').style.display = 'block';

            if (resp.ok && data.success) {
                document.getElementById('successAlert').style.display = 'block';
                document.getElementById('errorAlert').style.display = 'none';
                document.getElementById('successMsg').textContent = data.message;
                document.getElementById('previewLink').href = '/Exam/Preview/' + data.examId;
            } else {
                document.getElementById('successAlert').style.display = 'none';
                document.getElementById('errorAlert').style.display = 'block';
                const ul = document.getElementById('errorList');
                ul.innerHTML = '';
                (data.errors || [data.message]).forEach(err => {
                    const li = document.createElement('li');
                    li.textContent = err;
                    ul.appendChild(li);
                });
            }
        } catch (ex) {
            alert('Lỗi kết nối máy chủ: ' + ex.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-cloud-upload-alt mr-1"></i> Bắt đầu Kiểm tra & Import';
        }
    });
</script>
}
